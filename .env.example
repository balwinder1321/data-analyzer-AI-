# ============================================================
# AR Analytics — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ============================================================

# --- Authentication (Auth.js / NextAuth v5) ---
# Generate with: npx auth secret
AUTH_SECRET=

# --- Google OAuth ---
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Sheets API ---
# Enable at: https://console.cloud.google.com/apis/library/sheets.googleapis.com
# Uses the same Google OAuth credentials above.
# Set to "true" only after Google OAuth is fully configured.
GOOGLE_SHEETS_ENABLED=false

# --- AI — Google Gemini ---
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Database ---
# SQLite (development): file:./dev.db
# PostgreSQL (production): postgresql://user:password@host:5432/ar_analytics
DATABASE_URL=file:./dev.db

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Demo Mode ---
# Automatically enabled when GEMINI_API_KEY is not set.
# Set to "true" to force demo mode even with credentials.
DEMO_MODE=false
